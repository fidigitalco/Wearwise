{
  "expo": {
    "name": "WearWise",
    "slug": "wearwise",
    "scheme": "wearwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wearwise"
    },
    "android": {
      "package": "app.wearwise",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF8F5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "WearWise uses your photos to add clothes to your closet.",
          "cameraPermission": "WearWise uses the camera to photograph clothes for your closet."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WearWise uses your approximate location to match outfits to today's weather."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
