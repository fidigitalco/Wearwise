{
  "expo": {
    "name": "WearWise AI",
    "slug": "wearwise",
    "scheme": "wearwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wearwise",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.wearwise",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F4EF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161814"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WearWise uses your photos to add clothes to your closet.",
          "cameraPermission": "WearWise uses the camera to photograph clothes for your closet."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WearWise uses your approximate location to match outfits to today's weather."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "WearWise uses the microphone so you can ask the stylist with your voice."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
