DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Leave empty for SQLite (db.sqlite3). Production: postgres://user:pass@host:5432/wearwise
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Claude API key for AI garment tagging on photo upload (type, name, colours, pattern…).
# Without it, uploads still work but the user picks the type by hand.
ANTHROPIC_API_KEY=

# Voice questions (Azerbaijani, Russian, English). With a key, Whisper runs in the
# cloud in a second or two (Groq first); without one, locally: WHISPER_DETECT_MODEL
# tells the language, WHISPER_MODEL writes it down (~35 s on a slow laptop CPU).
GROQ_API_KEY=
OPENAI_API_KEY=
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DETECT_MODEL=small
# Optional: override the tagging model.
WEARWISE_VISION_MODEL=claude-opus-5-5

# Sign in with Apple: iOS bundle ids allowed as the token audience (Expo Go: host.exp.Exponent)
APPLE_AUDIENCES=host.exp.Exponent
# Sign in with Google: OAuth client ids from Google Cloud (web, iOS, Android), comma-separated
GOOGLE_CLIENT_IDS=
# Sign in with Apple on Android (web flow): a Services ID, and our public https callback registered for it
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=https://api.example.com/api/auth/apple/callback/
