# /etc/wearwise/wearwise.env — chmod 600, owner wearwise. Never commit the filled-in copy.
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=wearwise.164.68.119.214.sslip.io
CSRF_TRUSTED_ORIGINS=https://wearwise.164.68.119.214.sslip.io
DATABASE_URL=postgres://wearwise:CHANGE_ME@127.0.0.1:5432/wearwise
CORS_ALLOWED_ORIGINS=
# Voice in the cloud, so the server never loads the 1.6 GB Whisper model next to SaveDo.
GROQ_API_KEY=
# Optional: AI tagging of photos.
ANTHROPIC_API_KEY=
# Background removal stays off (WEARWISE_CUTOUTS=1 turns it on; it needs a lot of RAM).
WEARWISE_CUTOUTS=0
