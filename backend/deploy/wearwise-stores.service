[Unit]
Description=WearWise: import products from store connections
After=network.target postgresql.service

[Service]
Type=oneshot
User=wearwise
Group=wearwise
WorkingDirectory=/opt/wearwise/backend
EnvironmentFile=/etc/wearwise/wearwise.env
ExecStart=/opt/wearwise/venv/bin/python manage.py sync_stores
