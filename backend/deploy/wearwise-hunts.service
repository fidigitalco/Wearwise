[Unit]
Description=WearWise: re-run "Find me this" hunts and push new matches
After=network.target postgresql.service

[Service]
Type=oneshot
User=wearwise
Group=wearwise
WorkingDirectory=/opt/wearwise/backend
EnvironmentFile=/etc/wearwise/wearwise.env
ExecStart=/opt/wearwise/venv/bin/python manage.py run_hunts
